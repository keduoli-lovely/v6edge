{
	"luci-app-cfedge": {
		"description": "Grant access to cfedge (Cloudflare edge manager)",
		"read": {
			"file": {
				"/usr/bin/cfedge": [ "exec" ],
				"/etc/cfedge": [ "list" ],
				"/etc/cfedge/*": [ "list", "read" ],
				"/etc/nginx/conf.d/*": [ "list", "read" ],
				"/etc/config/cfedge": [ "read" ]
			},
			"ubus": {
				"file": [ "exec", "read", "list" ],
				"uci": [ "get" ],
				"service": [ "list" ]
			},
			"uci": [ "cfedge", "firewall", "nginx" ]
		},
		"write": {
			"file": {
				"/usr/bin/cfedge": [ "exec" ],
				"/etc/cfedge/*": [ "write" ]
			},
			"ubus": {
				"file": [ "exec" ]
			},
			"uci": [ "cfedge", "firewall", "nginx" ]
		}
	}
}
