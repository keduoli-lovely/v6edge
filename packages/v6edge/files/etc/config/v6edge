config global 'global'
	# Cloudflare 根域名（zone）
	option zone ''
	# 统一边缘端口：服务端口填 edge 时使用
	option edge_port '8443'
	# wildcard = 一张 *.zone 证书；per-domain = 每个域名单独签
	option cert_mode 'wildcard'
	# 证书邮箱（可选，Let's Encrypt 通知用）
	option cert_email ''
	# DDNS 守护
	option ddns_enabled '1'
	option ddns_interval '10'
